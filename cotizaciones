  /* ---------- Importador (Excel / pegado) ---------- */
  function parseNum(v){
    if(v==null || v==='') return null; if(typeof v==='number') return isFinite(v)?v:null;
    var s=String(v).replace(/[^\d.,\-]/g,''); if(!s || s==='-') return null;
    var hasDot=s.indexOf('.')>-1, hasCom=s.indexOf(',')>-1;
    if(hasDot && hasCom){ if(s.lastIndexOf(',')>s.lastIndexOf('.')) s=s.replace(/\./g,'').replace(',','.'); else s=s.replace(/,/g,''); }
    else if(hasCom){ s = /^-?\d{1,3}(,\d{3})+$/.test(s) ? s.replace(/,/g,'') : s.replace(',','.'); }
    else if(hasDot){ if(/^-?\d{1,3}(\.\d{3})+$/.test(s)) s=s.replace(/\./g,''); }
    var n=parseFloat(s); return isNaN(n)?null:n;
  }
  function cellStr(v){ if(v==null) return ''; if(v instanceof Date) return toISODate(v); return String(v).replace(/\s+/g,' ').trim(); }
  function parseDateVal(v){
    if(v instanceof Date) return toISODate(v);
    var s=cellStr(v), m=s.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{2,4})$/);
    if(m){ var y=m[3].length===2?'20'+m[3]:m[3]; return y+'-'+m[2].padStart(2,'0')+'-'+m[1].padStart(2,'0'); }
    if(/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0,10);
    if(typeof v==='number' && v>30000 && v<80000){ var d=new Date(Math.round((v-25569)*86400000)); return toISODate(new Date(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate())); }
    return '';
  }
  var HEADER_RULES=[
    ['descripcion', /\b(descripcion|producto|articulo|material|detalle|concepto)\b/],
    ['categoria', /\b(categoria|grupo|capitulo)\b/],
    ['unidad', /^(unidad|und|un|unid|u m|um|medida|unidad de medida)\b/],
    ['cantidad', /\b(cant|cantidad|qty|cant solicitada)\b/],
    ['costoUnit', /\b(unitario|unit|precio|valor unit|vr unit|vlr unit|costo)\b/],
    ['total', /\btotal\b/],
    ['marca', /\b(marca|referencia|ref|fabricante)\b/],
    ['observaciones', /\b(observacion|observaciones|nota|notas|comentario)\b/],
    ['proveedor', /\bproveedor\b/],
    ['itemNo', /^(item|n|no|nro|num|numero|#)$/]
  ];
  function mapHeader(row){
    var map={};
    row.forEach(function(v,ci){
      var h=norm(v); if(!h) return;
      if(/\btotal\b/.test(h) && !/unit/.test(h)){ if(map.total==null) map.total=ci; return; }
      for(var r=0;r<HEADER_RULES.length;r++){ var key=HEADER_RULES[r][0]; if(key==='total') continue; if(HEADER_RULES[r][1].test(h) && map[key]==null){ map[key]=ci; return; } }
    });
    return map;
  }
  function readMeta(label, value, meta){
    var l=norm(label); if(!l || value==='' || value==null) return;
    if(/solicitud|cotizacion proexcom/.test(l)) meta.solicitud=cellStr(value);
    else if(/^cliente/.test(l)) meta.cliente=cellStr(value);
    else if(/proyecto|obra/.test(l)) meta.proyecto=cellStr(value);
    else if(/proveedor|razon social/.test(l)) meta.proveedor=cellStr(value);
    else if(/fecha/.test(l)) meta.fecha=parseDateVal(value);
    else if(/entrega/.test(l)) meta.entrega=cellStr(value);
    else if(/pago/.test(l)) meta.pago=cellStr(value);
    else if(/referencia|cotizacion|numero|^n |^no /.test(l)) meta.referencia=cellStr(value);
  }
  function parseGrid(aoa){
    var rows=aoa.map(function(r){ return (r||[]).map(function(v){ return v==null?'':v; }); }).filter(function(r){ return r.some(function(v){ return cellStr(v)!==''; }); });
    var meta={}, hdr=-1, map=null;
    for(var r=0;r<Math.min(rows.length,40);r++){
      var m=mapHeader(rows[r]);
      if(m.descripcion!=null && Object.keys(m).length>=2){ hdr=r; map=m; break; }
    }
    var start=0;
    if(hdr>=0){
      for(var i=0;i<hdr;i++){ var cells=rows[i].map(cellStr), f=cells.findIndex(function(c){ return c; }); if(f<0) continue; var lab=cells[f], rest=rows[i].slice(f+1).find(function(v){ return cellStr(v)!==''; });
        if(lab.indexOf(':')>-1 && !rest){ rest=lab.split(':').slice(1).join(':').trim(); lab=lab.split(':')[0]; }
        readMeta(lab.replace(/:$/,''), rest, meta); }
      start=hdr+1;
    } else {
      map=guessColumns(rows);
    }
    var out=[], currentCat='';
    for(var j=start;j<rows.length;j++){
      var row=rows[j]; var g=function(k){ return map[k]!=null ? row[map[k]] : ''; };
      var desc=cellStr(g('descripcion'));
      if(!desc) continue;
      var nd=norm(desc); if(/^(sub ?total|total|iva|descuento|valor total|gran total)\b/.test(nd)) continue;
      var cant=parseNum(g('cantidad')), costo=parseNum(g('costoUnit')), total=parseNum(g('total'));
      var numericCount=[cant,costo,total].filter(function(x){ return x!=null; }).length;
      if(map.categoria==null && numericCount===0 && !cellStr(g('unidad')) && desc===desc.toUpperCase() && desc.length<60){ currentCat=desc; continue; }
      if(costo==null && total!=null && cant) costo=total/cant;
      out.push({ itemNo: parseNum(g('itemNo')) || null, categoria: cellStr(g('categoria')) || currentCat || '', descripcion: desc, unidad: cellStr(g('unidad')) || 'UND',
        cantidad: cant!=null?cant:1, costoUnit: costo!=null?costo:null, marca: cellStr(g('marca')), observaciones: cellStr(g('observaciones')), proveedor: cellStr(g('proveedor')) });
    }
    return {rows:out, meta:meta, headerFound:hdr>=0};
  }
  /* Sin encabezados: la columna de texto más larga es la descripción; la primera numérica, la cantidad;
     la segunda numérica, el valor unitario; una de texto corto, la unidad. */
  function guessColumns(rows){
    var ncols=Math.max.apply(null, rows.map(function(r){ return r.length; })), stats=[];
    for(var c=0;c<ncols;c++){
      var vals=rows.map(function(r){ return r[c]; }).filter(function(v){ return cellStr(v)!==''; });
      var nums=vals.filter(function(v){ return parseNum(v)!=null && !/[a-z]/i.test(String(v)); }).length;
      var avg=vals.reduce(function(s,v){ return s+cellStr(v).length; },0)/(vals.length||1);
      stats.push({c:c, n:vals.length, numeric: vals.length && nums/vals.length>0.7, avg:avg});
    }
    var map={}, text=stats.filter(function(s){ return s.n && !s.numeric; }).sort(function(a,b){ return b.avg-a.avg; });
    if(text[0]) map.descripcion=text[0].c;
    var shortT=text.slice(1).find(function(s){ return s.avg<=8; }); if(shortT) map.unidad=shortT.c;
    var nums=stats.filter(function(s){ return s.numeric; });
    if(nums.length && nums[0].c < (map.descripcion==null?99:map.descripcion) && nums.length>1){ map.itemNo=nums[0].c; nums=nums.slice(1); }
    if(nums[0]) map.cantidad=nums[0].c; if(nums[1]) map.costoUnit=nums[1].c; if(nums[2]) map.total=nums[2].c;
    return map;
  }
  function gridFromText(txt){
    var lines=String(txt||'').replace(/\r/g,'').split('\n').filter(function(l){ return l.trim(); });
    var sep = lines.some(function(l){ return l.indexOf('\t')>-1; }) ? '\t' : (lines.some(function(l){ return l.indexOf(';')>-1; }) ? ';' : null);
    return lines.map(function(l){ return sep ? l.split(sep) : [l]; });
  }
