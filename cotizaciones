<script>
(function(){
  var LOGO_PX = "data:image/png;base64,";
  var LOGO_NP = "data:image/png;base64,";
  var COT_ESTADOS = {por_armar:"Por armar", solicitada:"Esperando proveedores", enviada:"Enviada al cliente", aprobada:"Aprobada", rechazada:"Rechazada"};
  var ITEM_CATEGORIAS = ["Equipos","Materiales","Mano de obra","Servicios"];
  var NO_PROVEEDOR_CATS = ["Mano de obra"];
  var CONFIG_DEFAULT = {
    empresa:"Proexcom S.A.S.", nit:"800.112.380-7", direccion:"Calle 26 No. 17–95", ciudad:"Cartagena, Bolívar, Colombia (130001)",
    telefono:"(+57) 605 6517277", web:"www.proexcom.com", asesor:"Jorge Cantillo Martínez", cargo:"", asesorTel:"", asesorEmail:"",
    prefijo:"PX-", margen:20, iva:19, vigencia:15,
    condiciones:"Precios en pesos colombianos (COP).\nForma de pago: 50% anticipo y 50% contra entrega.\nGarantía según fabricante.\nLos precios pueden variar sin previo aviso después de la vigencia de la oferta."
  };
  var MAX_FILE = 174080;

  var state = {
    cotizaciones:new Map(), provs:new Map(), clientes:new Map(), config:{}, db:null,
    editingCotId:null, editingProvId:null, editingCliId:null,
    items:[], provItems:[], provArchivo:null, provArchivoRemoved:false, provMeta:{},
    imp:{target:'cot', rows:[], meta:{}}, preview:null
  };

  var fmtMoney = new Intl.NumberFormat('es-CO', {style:'currency', currency:'COP', maximumFractionDigits:0});
  function money(n){ return fmtMoney.format(Math.round(Number(n)||0)); }
  function $(id){ return document.getElementById(id); }
  function cfg(){ var o = Object.assign({}, CONFIG_DEFAULT); Object.keys(state.config||{}).forEach(function(k){ var v = state.config[k]; if(v!==undefined && v!==null && v!=='') o[k]=v; }); return o; }
  function toISODate(d){ return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
  function today(){ return toISODate(new Date()); }
  function fmtDate(iso){ if(!iso) return '—'; var d = new Date(iso+'T00:00:00'); if(isNaN(d)) return iso; return d.toLocaleDateString('es-CO',{day:'2-digit', month:'short', year:'numeric'}); }
  function escapeHtml(s){ return String(s==null?'':s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function norm(s){ return String(s==null?'':s).normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim(); }
  function sameName(a,b){ return norm(a) && norm(a)===norm(b); }
  function autoGrow(el){ el.style.height='auto'; el.style.height=Math.max(el.scrollHeight,33)+'px'; }
  function toast(msg, ms){ var t=$('toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(toast._t); toast._t=setTimeout(function(){ t.classList.remove('show'); }, ms||2600); }
  function passFilter(t,q){ return !q || String(t||'').toLowerCase().indexOf(q)!==-1; }
  function slugFile(s){ return String(s||'').trim().replace(/[^a-z0-9\-_. ]+/gi,'').replace(/\s+/g,'-') || 'Proexcom'; }
  function errMsg(e){ return (e && e.message) ? e.message : 'error'; }
  function isOpen(id){ return $(id).classList.contains('open'); }

  var _confirmResolve=null;
  function confirmDialog(msg, okLabel){ $('confirmMsg').textContent=msg; $('confirmOkBtn').textContent=okLabel||'Eliminar'; $('confirmOverlay').classList.add('open'); return new Promise(function(r){ _confirmResolve=r; }); }
  function _closeConfirm(v){ $('confirmOverlay').classList.remove('open'); var r=_confirmResolve; _confirmResolve=null; if(r) r(v); }
  $('confirmOkBtn').addEventListener('click', function(){ _closeConfirm(true); });
  $('confirmCancelBtn').addEventListener('click', function(){ _closeConfirm(false); });

  /* ---------- Navegación ---------- */
  var titles = {
    cotizaciones:['Cotizaciones','Arma la cotización, pide precios a proveedores y entrega la oferta con el membrete de Proexcom.'],
    proveedores:['Respuestas de proveedores','Cada cotización que te envía un proveedor, ligada a la cotización de Proexcom que la originó.'],
    clientes:['Clientes','Registra cada cliente una vez y sus datos se llenan solos al cotizar.'],
    plantillas:['Cómo funciona','El flujo de una cotización rápida y las plantillas de Excel para cargar información.'],
    config:['Datos de la empresa','Lo que aparece en el membrete, el emisor y las condiciones por defecto.']
  };
  function showView(v){
    Object.keys(titles).forEach(function(n){ $('view-'+n).classList.toggle('active', n===v); });
    document.querySelectorAll('.nav-btn').forEach(function(b){ b.classList.toggle('active', b.dataset.view===v); });
    $('pageTitle').textContent=titles[v][0]; $('pageSub').textContent=titles[v][1];
    $('sidebar').classList.remove('open');
    if(v==='config') fillConfigForm();
  }
  $('primaryNav').addEventListener('click', function(e){ var b=e.target.closest('.nav-btn'); if(b) showView(b.dataset.view); });
  $('menuBtn').addEventListener('click', function(){ $('sidebar').classList.toggle('open'); });

  $('cotEstadoFilter').innerHTML = '<option value="">Todos los estados</option>' + Object.keys(COT_ESTADOS).map(function(k){ return '<option value="'+k+'">'+COT_ESTADOS[k]+'</option>'; }).join('');
  $('cotEstado').innerHTML = Object.keys(COT_ESTADOS).map(function(k){ return '<option value="'+k+'">'+COT_ESTADOS[k]+'</option>'; }).join('');

  /* ---------- Cálculos ---------- */
  function lineVenta(it){ return (Number(it.cantidad)||0)*(Number(it.precioUnit)||0); }
  function lineCosto(it){ return (Number(it.cantidad)||0)*(Number(it.costoUnit)||0); }
  function hasCost(it){ return it.costoUnit!=null && it.costoUnit!=='' && !isNaN(Number(it.costoUnit)); }
  function calcTotals(c){
    var items = c.items||[];
    var sub = items.reduce(function(s,it){ return s+lineVenta(it); },0);
    var r = {sub:sub, admin:0, imprev:0, util:0, iva:0, total:0};
    if(c.costingMode==='aiu'){
      r.admin = sub*((Number(c.aiuAdministracionPct)||0)/100);
      r.imprev = sub*((Number(c.aiuImprevistosPct)||0)/100);
      r.util = sub*((Number(c.aiuUtilidadPct)||0)/100);
      var base = c.ivaBase==='utilidad' ? r.util : (sub+r.admin+r.imprev+r.util);
      r.iva = base*((Number(c.ivaPct)||0)/100);
      r.total = sub+r.admin+r.imprev+r.util+r.iva;
    } else {
      r.iva = sub*((Number(c.ivaPct)||0)/100);
      r.total = sub+r.iva;
    }
    return r;
  }
  function solicitudItems(items){ return (items||[]).filter(function(it){ return NO_PROVEEDOR_CATS.indexOf(it.categoria)===-1 && String(it.descripcion||'').trim(); }); }
  function priceFromCost(cost, margin){ return Math.round((Number(cost)||0)*(1+(Number(margin)||0)/100)); }

  /* Busca, dentro de una respuesta de proveedor, el ítem que corresponde a un ítem de la cotización:
     1) misma descripción (sin tildes, mayúsculas ni signos); 2) si la respuesta vino de nuestra Plantilla 2,
     el mismo número de ítem de la solicitud; 3) una descripción contiene a la otra (textos largos). */
  function matchProvItem(p, it, solIdx){
    var list = p.items||[]; var n = norm(it.descripcion); if(!n) return null;
    var f = list.find(function(pi){ return norm(pi.descripcion)===n && Number(pi.costoUnit)>0; });
    if(f) return f;
    if(p.desdePlantilla && solIdx>=0){
      f = list.find(function(pi){ return Number(pi.itemNo)===solIdx+1 && Number(pi.costoUnit)>0; });
      if(f) return f;
    }
    if(n.length>=14){
      f = list.find(function(pi){ var m=norm(pi.descripcion); return m.length>=14 && Number(pi.costoUnit)>0 && (m.indexOf(n)===0 || n.indexOf(m)===0); });
      if(f) return f;
    }
    return null;
  }
  function linkedProvs(cotId){ return cotId ? Array.from(state.provs.entries()).filter(function(e){ return e[1].cotizacionId===cotId; }) : []; }

  /* ---------- Listas auxiliares ---------- */
  function refreshLists(){
    var cs=new Set(); state.clientes.forEach(function(c){ if(c.nombre) cs.add(c.nombre); }); state.cotizaciones.forEach(function(c){ if(c.cliente) cs.add(c.cliente); });
    $('clientesList').innerHTML = Array.from(cs).sort().map(function(c){ return '<option value="'+escapeHtml(c)+'">'; }).join('');
    var ps=new Set(); state.provs.forEach(function(p){ if(p.proveedor) ps.add(p.proveedor); });
    $('proveedoresList').innerHTML = Array.from(ps).sort().map(function(p){ return '<option value="'+escapeHtml(p)+'">'; }).join('');
    cotSelect($('provCotFilter'), 'Todas las cotizaciones');
  }
  function cotSelect(sel, emptyLabel){
    var cur = sel.value;
    sel.innerHTML = '<option value="">'+(emptyLabel||'Ninguna')+'</option>' + sortedCots().map(function(e){ var c=e[1]; return '<option value="'+e[0]+'">'+escapeHtml((c.numero||'s/n')+' — '+(c.cliente||'sin cliente')+(c.descripcion?' · '+c.descripcion.slice(0,40):''))+'</option>'; }).join('');
    sel.value = cur;
  }
  function sortedCots(){ return Array.from(state.cotizaciones.entries()).sort(function(a,b){ return String(b[1].numero||'').localeCompare(String(a[1].numero||''), 'es', {numeric:true}); }); }
  function findClienteByNombre(n){ var f=null; state.clientes.forEach(function(c){ if(!f && sameName(c.nombre,n)) f=c; }); return f; }
  function autofillCliente(n, onlyBlank){
    var c=findClienteByNombre(n); if(!c) return;
    [['cotClienteNit','nit'],['cotClienteContacto','contacto'],['cotClienteDireccion','direccion'],['cotClienteCiudad','ciudad'],['cotClienteTelefono','telefono'],['cotClienteEmail','email']].forEach(function(f){
      var el=$(f[0]); if(onlyBlank && el.value.trim()) return; el.value=c[f[1]]||'';
    });
  }
  $('cotCliente').addEventListener('input', function(){ autofillCliente(this.value, false); });

  function nextCotNumero(){
    var pre = cfg().prefijo || ''; var max=0;
    state.cotizaciones.forEach(function(c){ var m=String(c.numero||'').match(/(\d+)(?!.*\d)/); if(m){ var n=parseInt(m[1],10); if(n>max) max=n; } });
    return pre + String(max+1).padStart(4,'0');
  }
  function nextOcNumero(){
    var max=0; state.provs.forEach(function(p){ var m=String(p.ocNumero||'').match(/(\d+)(?!.*\d)/); if(m){ var n=parseInt(m[1],10); if(n>max) max=n; } });
    return 'OC-' + String(max+1).padStart(4,'0');
  }

  /* ---------- Render: cotizaciones ---------- */
  function renderCotizaciones(){
    var q=$('cotSearch').value.trim().toLowerCase(), ef=$('cotEstadoFilter').value;
    var k={por_armar:0, solicitada:0, enviada:0, aprobada:0}, vEnv=0, vApr=0;
    state.cotizaciones.forEach(function(c){ if(k[c.estado]!=null) k[c.estado]++; var t=calcTotals(c).total; if(c.estado==='enviada') vEnv+=t; if(c.estado==='aprobada') vApr+=t; });
    $('kpiArmar').textContent=k.por_armar; $('kpiSolic').textContent=k.solicitada; $('kpiEnv').textContent=k.enviada; $('kpiApr').textContent=k.aprobada;
    $('kpiEnvSub').textContent=money(vEnv)+' en total'; $('kpiAprSub').textContent=money(vApr)+' en total';
    $('navCountCot').textContent=state.cotizaciones.size;
    var box=$('cotContainer');
    if(!state.cotizaciones.size){
      box.innerHTML='<div class="table-wrap"><div class="empty-state"><div style="font-weight:600; color:var(--text);">Aún no hay cotizaciones</div><div>Crea la primera e importa la lista de materiales desde Excel.</div><button class="btn primary" id="btnAddCotEmpty">Nueva cotización</button></div></div>';
      $('btnAddCotEmpty').addEventListener('click', function(){ openCotModal(); }); return;
    }
    var rows = sortedCots().filter(function(e){ var c=e[1]; if(ef && c.estado!==ef) return false; return !q || passFilter(c.cliente,q)||passFilter(c.numero,q)||passFilter(c.descripcion,q); });
    if(!rows.length){ box.innerHTML='<div class="table-wrap"><div class="empty-state">Ninguna cotización coincide con la búsqueda.</div></div>'; return; }
    var html='<div class="table-wrap"><table><thead><tr><th>N.°</th><th>Cliente</th><th>Título</th><th>Proveedores</th><th>Fecha</th><th>Total</th><th>Estado</th><th></th></tr></thead><tbody>';
    rows.forEach(function(e){
      var id=e[0], c=e[1], lp=linkedProvs(id);
      var assigned = new Set((c.items||[]).map(function(it){ return it.proveedor; }).filter(Boolean));
      html+='<tr data-id="'+id+'"><td class="num">'+escapeHtml(c.numero||'—')+'</td><td>'+escapeHtml(c.cliente||'—')+'</td>'+
        '<td><div class="d-title">'+escapeHtml(c.descripcion||'—')+'</div><div class="d-notes">'+(c.items||[]).length+' ítem(s)</div></td>'+
        '<td>'+(lp.length? '<span class="chip">'+lp.length+' respuesta(s)</span>' : '<span class="muted">—</span>')+(assigned.size?'<div class="d-notes">'+assigned.size+' asignado(s)</div>':'')+'</td>'+
        '<td class="num">'+fmtDate(c.fecha)+'</td><td class="num">'+money(calcTotals(c).total)+'</td>'+
        '<td><span class="pill st-'+escapeHtml(c.estado)+'">'+escapeHtml(COT_ESTADOS[c.estado]||c.estado||'—')+'</span></td>'+
        '<td><div class="row-actions">'+
          '<button class="icon-btn a-prev" title="Vista previa de la cotización"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"/><circle cx="12" cy="12" r="3"/></svg></button>'+
          '<button class="icon-btn a-inf" title="Informe de proveedores"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></button>'+
          '<button class="icon-btn a-edit" title="Editar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z"/></svg></button>'+
        '</div></td></tr>';
    });
    box.innerHTML=html+'</tbody></table></div>';
    box.querySelectorAll('.a-edit').forEach(function(b){ b.addEventListener('click', function(){ openCotModal(b.closest('tr').dataset.id); }); });
    box.querySelectorAll('.a-prev').forEach(function(b){ b.addEventListener('click', function(){ var id=b.closest('tr').dataset.id; previewCotizacion(Object.assign({_id:id}, state.cotizaciones.get(id))); }); });
    box.querySelectorAll('.a-inf').forEach(function(b){ b.addEventListener('click', function(){ var id=b.closest('tr').dataset.id; previewInforme(Object.assign({_id:id}, state.cotizaciones.get(id))); }); });
  }
  ['cotSearch','cotEstadoFilter'].forEach(function(id){ $(id).addEventListener('input', renderCotizaciones); $(id).addEventListener('change', renderCotizaciones); });

  /* ---------- Render: proveedores ---------- */
  function provTotal(p){ return (p.items||[]).reduce(function(s,it){ return s+lineCosto(it); },0); }
  function renderProveedores(){
    var q=$('provSearch').value.trim().toLowerCase(), cf=$('provCotFilter').value;
    $('navCountProv').textContent=state.provs.size;
    var box=$('provContainer');
    if(!state.provs.size){
      box.innerHTML='<div class="table-wrap"><div class="empty-state"><div style="font-weight:600; color:var(--text);">Aún no hay respuestas de proveedores</div><div>Cuando un proveedor te envíe precios, pásalos a la Plantilla 2 y regístralos aquí.</div><button class="btn primary" id="btnAddProvEmpty">Registrar respuesta</button></div></div>';
      $('btnAddProvEmpty').addEventListener('click', function(){ openProvModal(); }); return;
    }
    var rows=Array.from(state.provs.entries()).filter(function(e){ var p=e[1]; if(cf && p.cotizacionId!==cf) return false; return !q || passFilter(p.proveedor,q)||passFilter(p.numero,q); })
      .sort(function(a,b){ return String(b[1].fecha||'').localeCompare(String(a[1].fecha||'')); });
    if(!rows.length){ box.innerHTML='<div class="table-wrap"><div class="empty-state">Ninguna coincide con el filtro.</div></div>'; return; }
    var html='<div class="table-wrap"><table><thead><tr><th>Proveedor</th><th>Su referencia</th><th>Fecha</th><th>Cotización Proexcom</th><th>Ítems</th><th>Valor (costo)</th><th>Orden de compra</th><th></th></tr></thead><tbody>';
    rows.forEach(function(e){
