  .toast{position:fixed; bottom:20px; left:50%; transform:translateX(-50%) translateY(8px); background:var(--accent-2); color:#fff; padding:10px 18px; border-radius:9px; font-size:13px; box-shadow:var(--shadow); opacity:0; pointer-events:none; transition:opacity .18s, transform .18s; z-index:90; max-width:min(92vw,480px); text-align:center; line-height:1.4;}
  :root[data-theme="dark"] .toast{color:#0c1020;}
  @media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .toast{color:#0c1020;} }
  .toast.show{opacity:1; transform:translateX(-50%) translateY(0);}

  .menu-btn{display:none; border:1px solid var(--border); background:var(--surface); border-radius:8px; width:34px; height:34px; align-items:center; justify-content:center; color:var(--text); cursor:pointer; flex:none;}
  @media (max-width:760px){
    .sidebar{position:fixed; left:0; top:0; bottom:0; transform:translateX(-100%); transition:transform .2s; z-index:40; box-shadow:var(--shadow);}
    .sidebar.open{transform:none;}
    .main{padding:18px 16px 50px;}
    .menu-btn{display:inline-flex;}
  }
</style>

</head>
<body>
<div class="app">
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-logo"><img src="data:image/png;base64," alt="Proexcom"></div>
      <div class="brand-text"><strong>Cotizaciones rápidas</strong><span>Proexcom S.A.S. · Integración en Tecnologías</span></div>
    </div>
    <nav class="primary" id="primaryNav">
      <div class="nav-label">Trabajo</div>
      <button class="nav-btn active" data-view="cotizaciones">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 3h8l4 4v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M9 12h6M9 16h6M9 8h3"/></svg>
        Cotizaciones <span class="count" id="navCountCot">0</span>
      </button>
      <button class="nav-btn" data-view="proveedores">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h13v10H3z"/><path d="M16 10h3l2 3v4h-5"/><circle cx="7" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/></svg>
        Proveedores <span class="count" id="navCountProv">0</span>
      </button>
      <button class="nav-btn" data-view="clientes">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Clientes <span class="count" id="navCountCli">0</span>
      </button>
      <div class="nav-label">Ayuda y ajustes</div>
      <button class="nav-btn" data-view="plantillas">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
        Cómo funciona y plantillas
      </button>
      <button class="nav-btn" data-view="config">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>
        Datos de la empresa
      </button>
    </nav>
    <div class="side-foot"><strong>Proexcom S.A.S.</strong><br>NIT 800.112.380-7<br>Calle 26 No. 17–95, Cartagena<br>(+57) 605 6517277</div>
  </aside>

  <main class="main">
    <div class="topbar">
      <div style="display:flex; align-items:center; gap:10px;">
        <button class="menu-btn" id="menuBtn" aria-label="Abrir menú"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
        <div><h1 id="pageTitle">Cotizaciones</h1><p id="pageSub">Arma la cotización, pide precios a proveedores y entrega la oferta con el membrete de Proexcom.</p></div>
      </div>
      <div class="synctag"><span class="dot off" id="syncDot"></span><span id="syncLabel">Conectando…</span></div>
    </div>

    <!-- COTIZACIONES -->
    <section class="view active" id="view-cotizaciones">
      <div class="kpis">
        <div class="kpi"><div class="label">Por armar</div><div class="value" id="kpiArmar">0</div><div class="sub">sin precios completos</div></div>
        <div class="kpi"><div class="label">Esperando proveedores</div><div class="value" id="kpiSolic">0</div><div class="sub">solicitud enviada</div></div>
        <div class="kpi"><div class="label">Enviadas al cliente</div><div class="value" id="kpiEnv">0</div><div class="sub" id="kpiEnvSub">$0</div></div>
        <div class="kpi"><div class="label">Aprobadas</div><div class="value" id="kpiApr">0</div><div class="sub" id="kpiAprSub">$0</div></div>
      </div>
      <div class="filters">
        <input type="search" id="cotSearch" placeholder="Buscar por cliente, número o título…">
        <select id="cotEstadoFilter"><option value="">Todos los estados</option></select>
        <button class="btn primary" id="btnAddCot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>Nueva cotización</button>
      </div>
      <div id="cotContainer"></div>
    </section>

    <!-- PROVEEDORES -->
    <section class="view" id="view-proveedores">
      <div class="filters">
        <input type="search" id="provSearch" placeholder="Buscar proveedor o referencia…">
        <select id="provCotFilter"><option value="">Todas las cotizaciones</option></select>
        <button class="btn primary" id="btnAddProv"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>Registrar respuesta de proveedor</button>
      </div>
      <div id="provContainer"></div>
    </section>

    <!-- CLIENTES -->
    <section class="view" id="view-clientes">
      <div class="filters">
        <input type="search" id="cliSearch" placeholder="Buscar cliente…">
        <button class="btn primary" id="btnAddCli"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>Nuevo cliente</button>
      </div>
      <div id="cliContainer"></div>
    </section>

    <!-- CÓMO FUNCIONA -->
    <section class="view" id="view-plantillas">
      <div class="flow">
        <div class="flow-step"><span class="n">1</span><h3>Copia la lista</h3><p>Llega la lista de materiales. Cópiala en la <strong>Plantilla 1</strong>, o copia las filas directo desde Excel.</p></div>
        <div class="flow-step"><span class="n">2</span><h3>Súbela a la cotización</h3><p>Nueva cotización → <strong>Importar materiales</strong>. Los ítems quedan cargados con cantidad y unidad.</p></div>
        <div class="flow-step"><span class="n">3</span><h3>Pide precios</h3><p>Descarga la <strong>Solicitud a proveedor</strong>: Excel ya lleno con los ítems (Plantilla 2) o PDF con membrete.</p></div>
        <div class="flow-step"><span class="n">4</span><h3>Carga la respuesta</h3><p>Pasa los precios del proveedor a la Plantilla 2 y súbela en <strong>Registrar respuesta</strong>. Se liga sola por el N.° de solicitud.</p></div>
        <div class="flow-step"><span class="n">5</span><h3>Compara y entrega</h3><p>Asigna el mejor precio por ítem, fija la rentabilidad y descarga la cotización y el <strong>informe de proveedores</strong>.</p></div>
      </div>
      <div class="tpl-grid">
        <div class="tpl-card">
          <h3>Plantilla 1 · Lista de materiales</h3>
          <p>Para la lista que te envía el cliente o el área técnica. Arriba puedes poner cliente y proyecto; se llenan solos en la cotización.</p>
          <div class="colspec"><span>Ítem</span><span>Categoría</span><span class="req">Descripción</span><span>Unidad</span><span class="req">Cantidad</span><span>Observaciones</span></div>
          <div><button class="btn" id="dlTpl1">Descargar Plantilla 1 (Excel)</button></div>
        </div>
        <div class="tpl-card">
          <h3>Plantilla 2 · Respuesta del proveedor</h3>
          <p>La descargas desde cada cotización ya llena con los ítems y el N.° de solicitud. Esta versión en blanco sirve si el proveedor responde por otro medio.</p>
          <div class="colspec"><span>Ítem</span><span class="req">Descripción</span><span>Unidad</span><span>Cantidad</span><span class="req">Valor unitario</span><span>Valor total</span><span>Marca / referencia</span><span>Observaciones</span></div>
          <div><button class="btn" id="dlTpl2">Descargar Plantilla 2 en blanco</button></div>
        </div>
      </div>
      <p class="hint" style="margin-top:14px; max-width:760px;">Los nombres de columna no tienen que ser exactos: la página reconoce encabezados como “Descripción”, “Producto”, “Cant.”, “Und”, “Vlr. unit.” o “Precio”. Los valores con formato colombiano ($ 1.250.000) se leen bien. Si el proveedor envía PDF, copia su tabla y pégala en el cuadro de pegado del importador.</p>
    </section>

    <!-- CONFIG -->
    <section class="view" id="view-config">
      <div class="cfg-card">
        <div class="fieldset-label">Empresa (sale en el membrete y en los documentos)</div>
        <div class="field-row three">
          <div class="field"><label for="cfgEmpresa">Razón social</label><input id="cfgEmpresa" type="text"></div>
          <div class="field"><label for="cfgNit">NIT</label><input id="cfgNit" type="text"></div>
          <div class="field"><label for="cfgTelefono">Teléfono</label><input id="cfgTelefono" type="text"></div>
        </div>
        <div class="field-row three">
          <div class="field"><label for="cfgDireccion">Dirección</label><input id="cfgDireccion" type="text"></div>
          <div class="field"><label for="cfgCiudad">Ciudad</label><input id="cfgCiudad" type="text"></div>
          <div class="field"><label for="cfgWeb">Sitio web</label><input id="cfgWeb" type="text"></div>
        </div>
        <div class="fieldset-label">Asesor comercial por defecto</div>
        <div class="field-row four">
          <div class="field"><label for="cfgAsesor">Nombre</label><input id="cfgAsesor" type="text"></div>
          <div class="field"><label for="cfgCargo">Cargo</label><input id="cfgCargo" type="text"></div>
          <div class="field"><label for="cfgAsesorTel">Celular</label><input id="cfgAsesorTel" type="text"></div>
          <div class="field"><label for="cfgAsesorEmail">Correo</label><input id="cfgAsesorEmail" type="text"></div>
        </div>
        <div class="fieldset-label">Valores por defecto de cada cotización nueva</div>
        <div class="field-row four">
          <div class="field"><label for="cfgPrefijo">Prefijo del número</label><input id="cfgPrefijo" type="text"></div>
          <div class="field"><label for="cfgMargen">Rentabilidad sobre costo (%)</label><input id="cfgMargen" type="number" min="0" step="1"></div>
          <div class="field"><label for="cfgIva">IVA (%)</label><input id="cfgIva" type="number" min="0" step="1"></div>
          <div class="field"><label for="cfgVigencia">Vigencia (días)</label><input id="cfgVigencia" type="number" min="1" step="1"></div>
        </div>
        <div class="field"><label for="cfgCondiciones">Condiciones comerciales</label><textarea id="cfgCondiciones" style="min-height:110px;"></textarea></div>
        <div style="display:flex; justify-content:flex-end;"><button class="btn primary" id="cfgSave">Guardar datos</button></div>
        <div class="fieldset-label">Respaldo</div>
        <div class="hint">Las cotizaciones se guardan en este navegador. Si borras el historial o cambias de computador, se pierden: descarga un respaldo de vez en cuando y cárgalo en el otro equipo.</div>
        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;"><button class="btn" id="bkExport" type="button">Descargar respaldo (.json)</button><label class="btn" for="bkImport" style="cursor:pointer;">Cargar respaldo…</label><input type="file" id="bkImport" accept=".json" hidden></div>
      </div>
    </section>
  </main>
</div>

<!-- Modal: Cotización -->
<div class="overlay" id="cotOverlay">
  <div class="modal wide">
    <div class="modal-head"><h3 id="cotModalTitle">Nueva cotización</h3><button class="modal-close" id="cotClose" aria-label="Cerrar"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
    <div class="modal-body">
      <div class="fieldset-label">Datos generales</div>
      <div class="field-row four">
        <div class="field"><label for="cotNumero">N.° cotización</label><input type="text" id="cotNumero"></div>
        <div class="field"><label for="cotVersion">Versión</label><input type="number" id="cotVersion" min="1" step="1" value="1"></div>
        <div class="field"><label for="cotEstado">Estado</label><select id="cotEstado"></select></div>
        <div class="field"><label for="cotFecha">Fecha</label><input type="date" id="cotFecha"></div>
      </div>
      <div class="field-row three">
        <div class="field" style="grid-column:span 2;"><label for="cotDescripcion">Título del proyecto o suministro</label><input type="text" id="cotDescripcion" placeholder="Ej. Suministro de cableado estructurado Cat 6A"></div>
        <div class="field"><label for="cotResponsable">Asesor</label><input type="text" id="cotResponsable"></div>
      </div>

      <div class="fieldset-label">Datos del cliente</div>
      <div class="field-row three">
        <div class="field"><label for="cotCliente">Cliente</label><input type="text" id="cotCliente" list="clientesList"></div>
        <div class="field"><label for="cotClienteNit">NIT</label><input type="text" id="cotClienteNit"></div>
        <div class="field"><label for="cotClienteContacto">Atención (contacto)</label><input type="text" id="cotClienteContacto"></div>
      </div>
      <div class="field-row four">
        <div class="field"><label for="cotClienteDireccion">Dirección</label><input type="text" id="cotClienteDireccion"></div>
        <div class="field"><label for="cotClienteCiudad">Ciudad</label><input type="text" id="cotClienteCiudad"></div>
        <div class="field"><label for="cotClienteTelefono">Teléfono</label><input type="text" id="cotClienteTelefono"></div>
        <div class="field"><label for="cotClienteEmail">Correo</label><input type="text" id="cotClienteEmail"></div>
      </div>

      <div class="fieldset-label"><span><span class="step-tag">1</span>Ítems (materiales, equipos y mano de obra)</span></div>
      <div class="toolbar">
        <button class="btn" id="btnImportCot" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 10l5 5 5-5"/><path d="M5 21h14"/></svg>Importar materiales (Excel o pegar)</button>
        <button class="btn" id="btnAddItem" type="button">+ Agregar ítem</button>
        <div class="field" style="margin-left:auto;"><label for="cotMargenPct">Rentabilidad sobre costo (%)</label><input type="number" id="cotMargenPct" min="0" step="1"></div>
      </div>
      <div class="items-wrap">
        <table class="items-table">
          <thead><tr><th class="c-idx">#</th><th class="c-cat">Categoría</th><th>Descripción</th><th class="c-unit">Unidad</th><th class="c-qty">Cant.</th><th class="c-prov">Proveedor</th><th class="c-num">Costo unit.</th><th class="c-num">Vlr. unit. venta</th><th class="c-total">Total</th><th class="c-rm"></th></tr></thead>
          <tbody id="itemsBody"></tbody>
        </table>
      </div>
      <div class="hint">El valor de venta se calcula solo cuando el ítem tiene costo: costo × (1 + rentabilidad). Si lo escribes a mano, se respeta hasta que cambies el costo o la rentabilidad.</div>

      <div class="fieldset-label"><span><span class="step-tag">2</span>Proveedores: solicitud, respuestas y comparativo</span></div>
      <div class="prov-panel">
        <div class="prov-actions">
          <button class="btn" id="btnSolExcel" type="button">Solicitud en Excel (Plantilla 2 llena)</button>
          <button class="btn" id="btnSolPdf" type="button">Solicitud con membrete (PDF)</button>
          <button class="btn primary" id="btnNewProvFromCot" type="button">Registrar respuesta de proveedor</button>
        </div>
        <div id="cmpBox"></div>
      </div>

      <div class="fieldset-label"><span><span class="step-tag">3</span>Totales</span></div>
      <div class="totals-grid">
        <div class="margin-card" id="marginCard"></div>
        <div style="display:flex; flex-direction:column; gap:8px; align-items:flex-end;">
          <div class="field" style="flex-direction:row; align-items:center; gap:8px;"><label for="cotCostingMode" style="white-space:nowrap;">Modo de costeo</label>
            <select id="cotCostingMode" style="width:auto;"><option value="simple">Subtotal + IVA</option><option value="aiu">AIU (Administración, Imprevistos, Utilidad)</option></select></div>
          <div class="totals-box" id="totalsSimple">
            <div class="trow"><span>Subtotal</span><span class="num" id="cotSubtotalOut">$0</span></div>
            <div class="trow"><span>IVA <input type="number" id="cotIva" class="pct-input num" value="19" min="0" max="100">%</span><span class="num" id="cotIvaOut">$0</span></div>
            <div class="trow grand"><span>Total</span><span class="num" id="cotTotalOut">$0</span></div>
          </div>
          <div class="totals-box" id="totalsAiu" hidden>
            <div class="trow"><span>Subtotal</span><span class="num" id="aiuSubtotalOut">$0</span></div>
            <div class="trow"><span>Administración <input type="number" id="cotAdminPct" class="pct-input num" value="5" min="0">%</span><span class="num" id="aiuAdminOut">$0</span></div>
            <div class="trow"><span>Imprevistos <input type="number" id="cotImprevPct" class="pct-input num" value="3" min="0">%</span><span class="num" id="aiuImprevOut">$0</span></div>
            <div class="trow"><span>Utilidad <input type="number" id="cotUtilPct" class="pct-input num" value="10" min="0">%</span><span class="num" id="aiuUtilOut">$0</span></div>
            <div class="trow"><span>IVA <input type="number" id="cotIvaAiu" class="pct-input num" value="19" min="0">% <select id="cotIvaBase"><option value="utilidad">sobre Utilidad</option><option value="subtotal">sobre Subtotal</option></select></span><span class="num" id="aiuIvaOut">$0</span></div>
            <div class="trow grand"><span>Total</span><span class="num" id="aiuTotalOut">$0</span></div>
          </div>
        </div>
      </div>

      <div class="field-row">
        <div class="field"><label for="cotVigencia">Vigencia de la oferta (días)</label><input type="number" id="cotVigencia" min="1" step="1" value="15"></div>
        <div class="field"><label for="cotEntrega">Tiempo de entrega</label><input type="text" id="cotEntrega" placeholder="Ej. 8 a 10 días hábiles"></div>
      </div>
      <div class="field"><label for="cotCondiciones">Términos y condiciones</label><textarea id="cotCondiciones"></textarea></div>
      <div class="field"><label for="cotNotas">Notas internas (no salen en la cotización)</label><textarea id="cotNotas"></textarea></div>
    </div>
    <div class="modal-foot">
      <button class="btn red" id="cotDelete" hidden>Eliminar</button>
      <div class="right">
        <button class="btn" id="cotInformeBtn">Informe de proveedores</button>
        <button class="btn" id="cotPreviewBtn">Vista previa / descargar</button>
        <button class="btn" id="cotCancel">Cerrar</button>
        <button class="btn primary" id="cotSave">Guardar</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Respuesta de proveedor -->
<div class="overlay top" id="provOverlay">
  <div class="modal wide">
    <div class="modal-head"><h3 id="provModalTitle">Respuesta de proveedor</h3><button class="modal-close" id="provClose" aria-label="Cerrar"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
    <div class="modal-body">
      <div class="toolbar">
        <button class="btn primary" id="btnImportProv" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 10l5 5 5-5"/><path d="M5 21h14"/></svg>Importar respuesta (Plantilla 2 o pegar)</button>
        <span class="hint">Si subes la Plantilla 2, el proveedor, la referencia y la cotización se llenan solos.</span>
      </div>
      <div class="field-row three">
        <div class="field"><label for="provProveedor">Proveedor</label><input type="text" id="provProveedor" list="proveedoresList"></div>
        <div class="field"><label for="provNumero">N.° de cotización del proveedor</label><input type="text" id="provNumero"></div>
        <div class="field"><label for="provFecha">Fecha</label><input type="date" id="provFecha"></div>
      </div>
      <div class="field-row three">
        <div class="field"><label for="provCotizacion">Cotización Proexcom vinculada</label><select id="provCotizacion"></select></div>
        <div class="field"><label for="provEntrega">Tiempo de entrega</label><input type="text" id="provEntrega"></div>
        <div class="field"><label for="provPago">Forma de pago</label><input type="text" id="provPago"></div>
      </div>
      <div class="fieldset-label">Ítems con precio de costo</div>
      <div class="items-wrap">
        <table class="items-table">
          <thead><tr><th class="c-idx">#</th><th>Descripción</th><th class="c-unit">Unidad</th><th class="c-qty">Cant.</th><th class="c-num">Costo unit.</th><th class="c-marca">Marca / ref.</th><th class="c-total">Total</th><th class="c-rm"></th></tr></thead>
          <tbody id="provItemsBody"></tbody>
        </table>
      </div>
