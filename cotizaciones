      '<div class="pd-titlerow"><div class="pd-title"><div class="kick">Proveedores</div><h2>Solicitud de cotización</h2></div>'+infoBox([['Solicitud N.°', c.numero||'—'],['Fecha', fmtDate(today())],['Responder antes de', fmtDate(toISODate(new Date(Date.now()+3*86400000)))]])+'</div>'+
      '<div class="pd-bar">'+escapeHtml(c.descripcion||'Solicitud de precios')+'</div>'+
      '<div class="pd-cols"><div><h4>Proveedor</h4><div class="pd-f"><span>Empresa:</span>______________________________</div><div class="pd-f"><span>Contacto:</span>______________________________</div><div class="pd-f"><span>Su cotización N.°:</span>____________________</div></div>'+emisorCol(c.responsable, 'Solicita')+'</div>'+
      '<p style="margin:0 0 10px; font-size:11.5px;">Agradecemos cotizar los siguientes ítems indicando <strong>valor unitario antes de IVA</strong>, marca o referencia ofrecida, tiempo de entrega, forma de pago y vigencia. Por favor cite nuestra solicitud N.° <strong>'+escapeHtml(c.numero||'')+'</strong> en su respuesta.</p>'+
      '<table class="pd-table"><thead><tr><th style="width:30px;">Ítem</th><th>Descripción</th><th class="r">Cant.</th><th>Unidad</th><th style="width:100px;">Valor unit.</th><th style="width:100px;">Valor total</th><th style="width:110px;">Marca / ref.</th></tr></thead><tbody>'+rows+'</tbody></table>'+
      '<div class="pd-cols" style="margin-top:16px;"><div class="pd-f"><span>Tiempo de entrega:</span>______________________</div><div class="pd-f"><span>Forma de pago:</span>______________________</div></div>');
  }

  /* Informe: qué proveedores tiene la cotización, qué suministra cada uno y el comparativo de precios. */
  function docInforme(c, showCosts){
    var id=c._id, lp=linkedProvs(id), items=c.items||[];
    var provNames=[]; items.forEach(function(it){ var p=(it.proveedor||'').trim(); if(p && !provNames.some(function(x){ return sameName(x,p); })) provNames.push(p); });
    lp.forEach(function(e){ var p=(e[1].proveedor||'').trim(); if(p && !provNames.some(function(x){ return sameName(x,p); })) provNames.push(p); });
    var costoTotal=items.reduce(function(s,it){ return s+lineCosto(it); },0), r=calcTotals(c);
    function quoteOf(name){ var e=lp.find(function(x){ return sameName(x[1].proveedor, name); }); return e?e[1]:null; }
    var summary=provNames.map(function(name,k){
      var its=items.filter(function(it){ return sameName(it.proveedor,name); }), cost=its.reduce(function(s,it){ return s+lineCosto(it); },0), q=quoteOf(name);
      return '<tr><td class="num">'+(k+1)+'</td><td><strong>'+escapeHtml(name)+'</strong>'+(q&&q.entrega?'<div style="color:#5b6283; font-size:10.5px;">Entrega: '+escapeHtml(q.entrega)+(q.pago?' · Pago: '+escapeHtml(q.pago):'')+'</div>':'')+'</td><td>'+escapeHtml(q&&q.numero||'—')+'</td><td>'+(q?fmtDate(q.fecha):'—')+'</td><td class="num r">'+its.length+'</td>'+
        (showCosts?'<td class="num r">'+money(cost)+'</td><td class="num r">'+(costoTotal?(cost/costoTotal*100).toFixed(1)+'%':'—')+'</td>':'')+'</tr>';
    }).join('') || '<tr><td colspan="'+(showCosts?7:5)+'" style="text-align:center; color:#8a90ad;">Esta cotización todavía no tiene proveedores asignados.</td></tr>';
    var detail=provNames.map(function(name){
      var its=items.filter(function(it){ return sameName(it.proveedor,name); }); if(!its.length) return '';
      return '<tr class="cat"><td colspan="'+(showCosts?6:4)+'">'+escapeHtml(name)+'</td></tr>'+its.map(function(it){ return '<tr><td class="num">'+(items.indexOf(it)+1)+'</td><td>'+escapeHtml(it.descripcion)+(it.marca?'<div style="color:#5b6283; font-size:10.5px;">'+escapeHtml(it.marca)+'</div>':'')+'</td><td class="num r">'+(it.cantidad||0)+'</td><td>'+escapeHtml(it.unidad||'')+'</td>'+(showCosts?'<td class="num r">'+money(it.costoUnit)+'</td><td class="num r">'+money(lineCosto(it))+'</td>':'')+'</tr>'; }).join('');
    }).join('');
    var pend=solicitudItems(items).filter(function(it){ return !(it.proveedor||'').trim(); });
    if(pend.length) detail+='<tr class="cat"><td colspan="'+(showCosts?6:4)+'">Sin proveedor asignado</td></tr>'+pend.map(function(it){ return '<tr><td class="num">'+(items.indexOf(it)+1)+'</td><td>'+escapeHtml(it.descripcion)+'</td><td class="num r">'+(it.cantidad||0)+'</td><td>'+escapeHtml(it.unidad||'')+'</td>'+(showCosts?'<td class="num r">'+(hasCost(it)?money(it.costoUnit):'—')+'</td><td class="num r">'+(hasCost(it)?money(lineCosto(it)):'—')+'</td>':'')+'</tr>'; }).join('');
    var cmp='';
    if(showCosts && lp.length>1){
      var sol=solicitudItems(items);
      cmp='<div class="pd-h3">Comparativo de precios unitarios</div><table class="pd-table"><thead><tr><th style="width:30px;">Ítem</th><th>Descripción</th>'+lp.map(function(e){ return '<th class="r">'+escapeHtml(e[1].proveedor||'')+'</th>'; }).join('')+'</tr></thead><tbody>'+
        sol.map(function(it,k){ var ms=lp.map(function(e){ return matchProvItem(e[1], it, k); }); var best=Math.min.apply(null, ms.map(function(m){ return m?Number(m.costoUnit):Infinity; }));
          return '<tr><td class="num">'+(items.indexOf(it)+1)+'</td><td>'+escapeHtml(it.descripcion)+'</td>'+ms.map(function(m,j){ if(!m) return '<td class="r" style="color:#8a90ad;">—</td>'; var sel=sameName(it.proveedor, lp[j][1].proveedor); return '<td class="num r'+(Number(m.costoUnit)===best?' best':'')+(sel?' sel':'')+'">'+money(m.costoUnit)+'</td>'; }).join('')+'</tr>'; }).join('')+
        '</tbody></table><div class="pd-note">Verde: precio más económico. Recuadro: proveedor asignado en la cotización.</div>';
    }
    var totals = showCosts ? '<div class="pd-totals"><div><span>Costo total de proveedores</span><span class="num">'+money(costoTotal)+'</span></div><div><span>Venta antes de IVA</span><span class="num">'+money(r.sub)+'</span></div><div class="t"><span>Margen bruto</span><span class="num">'+money(r.sub-costoTotal)+' ('+(r.sub?((r.sub-costoTotal)/r.sub*100).toFixed(1):'0.0')+'%)</span></div></div>' : '';
    return docShell(
      '<div class="pd-titlerow"><div class="pd-title"><div class="kick">'+(showCosts?'Uso interno':'Informe')+'</div><h2>Informe de proveedores</h2></div>'+infoBox([['Cotización N.°', c.numero||'—'],['Cliente', c.cliente||'—'],['Fecha del informe', fmtDate(today())]])+'</div>'+
      '<div class="pd-bar">'+escapeHtml(c.descripcion||'Cotización')+'</div>'+
      '<p style="margin:12px 0 8px; font-size:12px;">Esta cotización tiene <strong>'+provNames.length+' proveedor'+(provNames.length===1?'':'es')+'</strong>'+(provNames.length?': '+provNames.map(escapeHtml).join(', ')+'.':'.')+(pend.length?' Quedan <strong>'+pend.length+' ítem(s)</strong> de suministro sin proveedor asignado.':'')+'</p>'+
      '<table class="pd-table"><thead><tr><th style="width:30px;">#</th><th>Proveedor</th><th>Su cotización</th><th>Fecha</th><th class="r">Ítems</th>'+(showCosts?'<th class="r">Costo (sin IVA)</th><th class="r">Participación</th>':'')+'</tr></thead><tbody>'+summary+'</tbody></table>'+
      totals+
      (detail?'<div class="pd-h3">Ítems por proveedor</div><table class="pd-table"><thead><tr><th style="width:30px;">Ítem</th><th>Descripción</th><th class="r">Cant.</th><th>Unidad</th>'+(showCosts?'<th class="r">Costo unit.</th><th class="r">Costo total</th>':'')+'</tr></thead><tbody>'+detail+'</tbody></table>':'')+
      cmp);
  }

  function docOrdenCompra(p, items, ocNumero, cot){
    var C=cfg(), sub=items.reduce(function(s,it){ return s+lineCosto(it); },0), iva=sub*((Number(C.iva)||0)/100);
    var rows=items.map(function(it,k){ return '<tr><td class="num">'+(k+1)+'</td><td>'+escapeHtml(it.descripcion)+(it.marca?'<div style="color:#5b6283; font-size:10.5px;">'+escapeHtml(it.marca)+'</div>':'')+'</td><td class="num r">'+(it.cantidad||0)+'</td><td>'+escapeHtml(it.unidad||'')+'</td><td class="num r">'+money(it.costoUnit)+'</td><td class="num r">'+money(lineCosto(it))+'</td></tr>'; }).join('') || '<tr><td colspan="6" style="text-align:center; color:#8a90ad;">Sin ítems.</td></tr>';
    return docShell(
      '<div class="pd-titlerow"><div class="pd-title"><div class="kick">Compras</div><h2>Orden de compra</h2></div>'+infoBox([['Orden N.°', ocNumero],['Fecha', fmtDate(today())],['Su cotización', p.numero||'—'],['Referencia interna', cot?(cot.numero||'—'):'—']])+'</div>'+
      '<div class="pd-bar">'+escapeHtml(cot&&cot.descripcion ? cot.descripcion : 'Orden de compra de materiales')+'</div>'+
      '<div class="pd-cols"><div><h4>Proveedor</h4><div class="pd-f"><span>Proveedor:</span><strong>'+escapeHtml(p.proveedor||'—')+'</strong></div><div class="pd-f"><span>Cotización:</span>'+escapeHtml(p.numero||'—')+(p.fecha?' del '+fmtDate(p.fecha):'')+'</div>'+(p.entrega?'<div class="pd-f"><span>Entrega:</span>'+escapeHtml(p.entrega)+'</div>':'')+(p.pago?'<div class="pd-f"><span>Pago:</span>'+escapeHtml(p.pago)+'</div>':'')+'</div>'+
      '<div><h4>Facturar a</h4><div class="pd-f"><span>Empresa:</span><strong>'+escapeHtml(C.empresa)+'</strong></div><div class="pd-f"><span>NIT:</span>'+escapeHtml(C.nit)+'</div><div class="pd-f"><span>Dirección:</span>'+escapeHtml(C.direccion)+', Cartagena</div><div class="pd-f"><span>Teléfono:</span>'+escapeHtml(C.telefono)+'</div><div class="pd-f"><span>Comprador:</span>'+escapeHtml(C.asesor)+'</div></div></div>'+
      '<table class="pd-table"><thead><tr><th style="width:30px;">Ítem</th><th>Descripción</th><th class="r">Cant.</th><th>Unidad</th><th class="r">Valor unitario</th><th class="r">Valor total</th></tr></thead><tbody>'+rows+'</tbody></table>'+
      '<div class="pd-totals"><div><span>Subtotal</span><span class="num">'+money(sub)+'</span></div><div><span>IVA ('+(C.iva||0)+'%)</span><span class="num">'+money(iva)+'</span></div><div class="t"><span>Total orden</span><span class="num">'+money(sub+iva)+'</span></div></div>'+
      '<div class="pd-terms"><h4>Condiciones</h4><p>'+escapeHtml(['Citar esta orden N.° '+ocNumero+' en la factura y en la remisión.', p.entrega?'Tiempo de entrega acordado: '+p.entrega+'.':'', p.pago?'Forma de pago: '+p.pago+'.':'', 'Los precios corresponden a la cotización del proveedor '+(p.numero||'')+'.', p.notas||''].filter(Boolean).join('\n'))+'</p></div>'+
      '<div class="pd-sign"><div>Autorizado por<br><span style="color:#5b6283;">'+escapeHtml(C.empresa)+'</span></div><div>Recibido por el proveedor<br><span style="color:#5b6283;">Nombre, firma y fecha</span></div></div>');
  }

  /* ---------- Vista previa y descarga ---------- */
  function openPreview(title, html, filename, controlsHtml, onControls){
    state.preview={title:title, filename:filename};
    $('previewTitle').textContent=title; $('previewDoc').innerHTML=html;
    var ctl=$('previewControls'); if(controlsHtml){ ctl.innerHTML=controlsHtml; ctl.hidden=false; if(onControls) onControls(ctl); } else { ctl.innerHTML=''; ctl.hidden=true; }
    $('previewOverlay').classList.add('open');
  }
  function closePreview(){ $('previewOverlay').classList.remove('open'); }
  $('previewClose').addEventListener('click', closePreview); $('previewCancel').addEventListener('click', closePreview);
  function buildPrintDocument(inner, title){
    return '<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>'+escapeHtml(title)+'</title>'+
      '<link href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@600;700;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">'+
      '<style>*{-webkit-print-color-adjust:exact !important; print-color-adjust:exact !important;} body{margin:0; background:#dfe2ec;} .wrap{padding:18px 12px;} '+DOC_CSS+
      ' .print-bar{position:sticky; top:0; display:flex; gap:12px; align-items:center; justify-content:center; background:#002060; color:#fff; padding:10px 16px; font:13px "IBM Plex Sans",sans-serif; z-index:5;} .print-bar button{background:#fff; color:#002060; border:none; border-radius:7px; padding:7px 16px; font-weight:700; cursor:pointer;}'+
      ' @page{size:letter; margin:10mm;} @media print{ .print-bar{display:none !important;} body{background:#fff;} .wrap{padding:0;} .pdoc{box-shadow:none; max-width:100%;} .pd-table tr{break-inside:avoid;} .pd-terms,.pd-sign,.pd-totals{break-inside:avoid;} }</style></head><body>'+
      '<div class="print-bar">Usa Ctrl+P (Cmd+P en Mac) y elige “Guardar como PDF”. En “Más ajustes” desactiva “Encabezados y pies de página”. <button id="pbtn" type="button">Imprimir / PDF</button></div><div class="wrap">'+inner+'</div>'+
      '<scr'+'ipt>document.getElementById("pbtn").addEventListener("click",function(){window.print();});window.addEventListener("load",function(){setTimeout(function(){try{window.focus();window.print();}catch(e){}},400);});</scr'+'ipt></body></html>';
  }
  $('previewPrint').addEventListener('click', function(){
    var inner=$('previewDoc').innerHTML; if(!inner.trim() || !state.preview) return;
    var w=window.open('', '_blank');
    if(!w){ toast('El navegador bloqueó la ventana. Permite ventanas emergentes para esta página o usa “Descargar HTML”.', 6000); return; }
    w.document.open(); w.document.write(buildPrintDocument(inner, state.preview.title)); w.document.close();
  });
  $('previewDownload').addEventListener('click', function(){
    var inner=$('previewDoc').innerHTML; if(!inner.trim() || !state.preview) return;
    saveFile(state.preview.filename, buildPrintDocument(inner, state.preview.title), 'Descargado. Ábrelo y usa Ctrl+P → Guardar como PDF.');
  });
  function previewCotizacion(c){ openPreview('Cotización '+(c.numero||''), docCotizacion(c), 'Cotizacion-'+slugFile(c.numero)+'.html'); }
  function previewInforme(c){
    var show=true;
    openPreview('Informe de proveedores '+(c.numero||''), docInforme(c, show), 'Informe-proveedores-'+slugFile(c.numero)+'.html',
      '<label style="display:flex; gap:6px; align-items:center; cursor:pointer;"><input type="checkbox" id="infCosts" checked> Mostrar costos, margen y comparativo (desmárcalo si el informe es para el cliente)</label>',
      function(ctl){ ctl.querySelector('#infCosts').addEventListener('change', function(){ show=this.checked; $('previewDoc').innerHTML=docInforme(c, show); }); });
  }
  function previewOrdenCompra(pid, p){
    var cot=p.cotizacionId?state.cotizaciones.get(p.cotizacionId):null, items=[];
    if(cot){ items=(cot.items||[]).filter(function(it){ return sameName(it.proveedor, p.proveedor) && hasCost(it); }); }
    var fromCot=items.length>0;
    if(!fromCot) items=(p.items||[]).filter(function(it){ return Number(it.costoUnit)>0; });
    if(!items.length){ toast('Esta respuesta no tiene ítems con precio para la orden de compra.'); return; }
    var oc=p.ocNumero||nextOcNumero();
    openPreview('Orden de compra '+oc, docOrdenCompra(p, items, oc, cot), 'Orden-de-compra-'+slugFile(oc)+'-'+slugFile(p.proveedor)+'.html',
      '<span class="muted">'+(fromCot?'Incluye solo los '+items.length+' ítem(s) asignados a este proveedor en la cotización '+escapeHtml(cot.numero||'')+'.':'Incluye todos los ítems con precio de la respuesta del proveedor.')+'</span>');
    if(!p.ocNumero && pid && state.db){
      state.provMeta.ocNumero = (state.editingProvId===pid) ? oc : state.provMeta.ocNumero;
      var ex=state.provs.get(pid); if(ex) state.db.collection('cotizacionesProveedor').doc(pid).set(Object.assign({}, ex, {ocNumero:oc})).catch(function(){});
    }
  }

  /* ---------- Configuración ---------- */
  var CFG_FIELDS=[['cfgEmpresa','empresa'],['cfgNit','nit'],['cfgTelefono','telefono'],['cfgDireccion','direccion'],['cfgCiudad','ciudad'],['cfgWeb','web'],['cfgAsesor','asesor'],['cfgCargo','cargo'],['cfgAsesorTel','asesorTel'],['cfgAsesorEmail','asesorEmail'],['cfgPrefijo','prefijo'],['cfgMargen','margen'],['cfgIva','iva'],['cfgVigencia','vigencia'],['cfgCondiciones','condiciones']];
  function fillConfigForm(){ var C=cfg(); CFG_FIELDS.forEach(function(f){ $(f[0]).value = C[f[1]]!=null?C[f[1]]:''; }); }
  $('cfgSave').addEventListener('click', function(){
    var db=requireDb(); if(!db) return; var d={};
    CFG_FIELDS.forEach(function(f){ var v=$(f[0]).value; d[f[1]] = (['margen','iva','vigencia'].indexOf(f[1])>-1) ? (v===''?null:Number(v)) : v.trim(); });
    db.doc('config/empresa').set(d).then(function(){ toast('Datos guardados'); }).catch(function(e){ toast('No se pudo guardar: '+errMsg(e)); });
  });

  /* ---------- Almacenamiento compartido ---------- */
  function requireDb(){ if(!state.db){ toast('El guardado no está listo. Recarga la página.'); return null; } return state.db; }
  function setSync(ok, label){ $('syncDot').classList.toggle('off', !ok); $('syncLabel').textContent=label; }
  /* Almacenamiento local: todo se guarda en este navegador (localStorage), con la misma forma
     de colecciones y documentos que usaba la versión de Claude. */
  var LS_KEY='proexcom-cotizaciones-v1';
  function createLocalDb(){
    var store={cotizaciones:{}, cotizacionesProveedor:{}, clientes:{}, config:{}}, colL={}, docL={}, okStorage=true;
    try{ var raw=localStorage.getItem(LS_KEY); if(raw){ var o=JSON.parse(raw); Object.keys(o).forEach(function(k){ store[k]=o[k]||{}; }); } }catch(e){ okStorage=false; }
    function clone(x){ return JSON.parse(JSON.stringify(x)); }
    function persist(){ try{ localStorage.setItem(LS_KEY, JSON.stringify(store)); }catch(e){ toast('El navegador no dejó guardar (espacio lleno o modo privado). Descarga un respaldo en “Datos de la empresa”.', 7000); } }
    function colSnap(col){ var o=store[col]||{}; return {docs:Object.keys(o).map(function(id){ return {id:id, data:function(){ return o[id]; }}; })}; }
    function docSnap(col,id){ var v=(store[col]||{})[id]; return {exists:v!==undefined, data:function(){ return v; }}; }
    function notify(col,id){ (colL[col]||[]).forEach(function(cb){ setTimeout(function(){ cb(colSnap(col)); },0); }); (docL[col+'/'+id]||[]).forEach(function(cb){ setTimeout(function(){ cb(docSnap(col,id)); },0); }); }
    function genId(){ return Date.now().toString(36)+Math.random().toString(36).slice(2,8); }
    function docRef(col,id){ return {
      set:function(d){ (store[col]=store[col]||{})[id]=clone(d); persist(); notify(col,id); return Promise.resolve(); },
      delete:function(){ if(store[col]) delete store[col][id]; persist(); notify(col,id); return Promise.resolve(); },
      onSnapshot:function(cb){ (docL[col+'/'+id]=docL[col+'/'+id]||[]).push(cb); setTimeout(function(){ cb(docSnap(col,id)); },0); }
    }; }
    return {
      ok: okStorage,
      collection:function(col){ return {
        add:function(d){ var id=genId(); return docRef(col,id).set(d).then(function(){ return {id:id}; }); },
        doc:function(id){ return docRef(col,id); },
        onSnapshot:function(cb){ (colL[col]=colL[col]||[]).push(cb); setTimeout(function(){ cb(colSnap(col)); },0); }
      }; },
      doc:function(path){ var p=path.split('/'); return docRef(p[0],p[1]); },
      exportAll:function(){ return JSON.stringify({app:'cotizaciones-proexcom', version:1, fecha:new Date().toISOString(), datos:store}, null, 1); },
      importAll:function(obj){ var d=obj&&obj.datos; if(!d || typeof d!=='object') throw new Error('El archivo no es un respaldo de esta página.'); store={cotizaciones:d.cotizaciones||{}, cotizacionesProveedor:d.cotizacionesProveedor||{}, clientes:d.clientes||{}, config:d.config||{}}; persist(); ['cotizaciones','cotizacionesProveedor','clientes'].forEach(function(c){ notify(c,''); }); notify('config','empresa'); }
    };
  }
  function initDb(){
    var db=createLocalDb(); state.db=db;
    setSync(db.ok, db.ok ? 'Guardado en este navegador' : 'Sin guardado (modo privado)');
    function sub(name, key){ db.collection(name).onSnapshot(function(snap){ state[key]=new Map(snap.docs.map(function(d){ return [d.id, d.data()]; })); renderAll(); }); }
    sub('cotizaciones','cotizaciones'); sub('cotizacionesProveedor','provs'); sub('clientes','clientes');
    db.doc('config/empresa').onSnapshot(function(s){ state.config=(s && s.exists)?(s.data()||{}):{}; if($('view-config').classList.contains('active')) fillConfigForm(); });
  }
  $('bkExport').addEventListener('click', function(){ if(!state.db) return; saveFile('Respaldo-cotizaciones-Proexcom-'+today()+'.json', state.db.exportAll(), 'Respaldo descargado.'); });
  $('bkImport').addEventListener('change', function(e){
    var f=e.target.files&&e.target.files[0]; if(!f) return; e.target.value='';
    confirmDialog('¿Cargar este respaldo? Reemplaza todo lo que hay guardado en este navegador.', 'Cargar respaldo').then(function(ok){
      if(!ok) return; var r=new FileReader();
      r.onload=function(){ try{ state.db.importAll(JSON.parse(r.result)); toast('Respaldo cargado.'); }catch(err){ toast('No se pudo cargar: '+errMsg(err), 5000); } };
      r.readAsText(f);
    });
  });
  renderAll();
  initDb();
})();
</script>

